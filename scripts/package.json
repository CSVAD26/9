{
  "name": "mat236-student-9",
  "version": "1.0.0",
  "private": true,
  "description": "MAT 236 computational art and design assignments",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node prepare-vendor.mjs",
    "vendor": "node prepare-vendor.mjs",
    "predev": "npm run vendor",
    "dev": "vite --config vite.config.js --host 127.0.0.1",
    "predev:assignment2": "npm run vendor",
    "dev:assignment2": "vite --config vite.config.js --host 127.0.0.1",
    "dev:spectrum": "npm --prefix ../assignments/ImpossibleColors run dev",
    "start": "npm run dev",
    "build": "node build.mjs",
    "preview": "vite preview --config vite.config.js --host 127.0.0.1",
    "check": "npm run build && npm run test:site",
    "test:site": "node --test ../assignments/ImpossibleColors/tests/site-build.test.mjs"
  },
  "dependencies": {
    "p5": "1.10.0"
  },
  "devDependencies": {
    "vite": "8.3.1"
  }
}
